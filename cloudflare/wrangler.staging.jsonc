{
  "name": "dong-song-game-staging",
  "main": "api/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/dev",
      "/dev/*"
    ]
  },
  "vars": {
    "RELEASE_ID": "migration-m01"
  }
}
