{
  "name": "dong-song-game-staging",
  "main": "api/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*", "/dev", "/dev/*"]
  },
  "vars": {
    "RELEASE_ID": "migration-m02-qa",
    "APP_URL": "https://dong-song-game-staging.phungthienphu.workers.dev",
    "AUTH_DATABASE": "dong_song_cloudflare_qa",
    "AUTH_ENABLED": "true"
  }
}
