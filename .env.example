# MongoDB Atlas hoặc Mongo local
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dong_song_thoi_dai

# Đăng nhập (AUTH_SECRET: chuỗi ngẫu nhiên >= 32 ký tự, ví dụ `openssl rand -base64 48`)
AUTH_SECRET=
APP_URL=http://localhost:3457
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI: http://localhost:3457/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
